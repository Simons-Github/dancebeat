{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run test:*)",
      "Bash(bun run lint)",
      "Bash(bun run build)"
    ],
    "deny": [
      "Read(./dist/**)",
      "Read(./.tanstack/**)",
      "Read(./coverage/**)",
      "Read(./bun.lock)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.mp3)",
      "Read(./**/*.m4a)",
      "Read(./**/*.wav)",
      "Read(./**/*.ogg)",
      "Read(./**/*.flac)",
      "Read(./**/*.mp4)",
      "Read(./**/*.mov)",
      "Read(./**/*.webm)",
      "Read(./**/*.mkv)",
      "Read(./**/*.task)",
      "Read(./**/*.wasm)"
    ]
  }
}
